{
  "name": "cloud-native-graphql-gateway",
  "version": "2.0.0",
  "description": "REST + GraphQL API gateway (Express, Apollo Server) with Clean Architecture, circuit breakers and Prometheus metrics",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:unit": "npm test -- tests/unit",
    "test:integration": "npm test -- tests/integration",
    "test:coverage": "npm test -- --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "graphql": "^16.14.2",
    "graphql-query-complexity": "^2.0.0",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "opossum": "^10.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "sql.js": "^1.15.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    }
  }
}
