# Copy to .env and adjust. `npm start` / `npm run dev` load it automatically
# (node --env-file-if-exists); docker compose reads it for interpolation.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# SQLite file (sql.js). Use :memory: for an ephemeral database.
DB_FILE=./data/gateway.db

# Comma-separated API keys (min. 16 chars each). Required in production and
# by docker compose. Generate one with: openssl rand -hex 32
API_KEYS=
# AUTH_ENABLED=false   # explicit opt-out (not recommended outside local dev)

# GraphQL hardening (defaults: introspection/landing page only outside production)
# GRAPHQL_INTROSPECTION=false
# GRAPHQL_LANDING_PAGE=false
# GRAPHQL_MAX_DEPTH=7
# GRAPHQL_MAX_COMPLEXITY=1000

# HTTP
# CORS_ORIGINS=*                 # comma-separated list of allowed origins
# TRUST_PROXY=1                  # number of proxies in front (ingress/load balancer)
# BODY_LIMIT=100kb
# REQUEST_TIMEOUT_MS=30000
# SHUTDOWN_TIMEOUT_MS=10000
# API_DOCS_ENABLED=true

# Rate limiting / load shedding (0 disables)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WRITE_MAX=30
# LOAD_SHED_THRESHOLD=1          # 1-minute load average per CPU

# Upstream resilience (circuit breakers around data sources)
# UPSTREAM_TIMEOUT_MS=3000
# CIRCUIT_ERROR_THRESHOLD=50
# CIRCUIT_RESET_MS=10000
# CIRCUIT_VOLUME_THRESHOLD=10
# STALE_CACHE_SIZE=500

# docker compose only
GRAFANA_ADMIN_PASSWORD=
