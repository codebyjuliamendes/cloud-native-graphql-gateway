    "/health": {
      "get": {
        "tags": ["ops"],
        "security": [],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Process is alive"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["ops"],
        "security": [],
        "summary": "Readiness probe",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Not ready or shutting down"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key sent as a bearer token"
      },
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "isStale": {
            "type": "boolean"
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "isStale": {
            "type": "boolean"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "productIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "totalAmount": {
            "type": "number"
          },
          "isStale": {
            "type": "boolean"
          }
        }
      },
      "CreateUser": {
        "type": "object",
        "required": ["name", "email"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        }
      },
      "CreateProduct": {
        "type": "object",
        "required": ["name", "price"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "description": "At most two decimal places"
          }
        }
      },
      "CreateOrder": {
        "type": "object",
        "required": ["userId", "productIds"],
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "string"
          },
          "productIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string"
            },
            "description": "Repeat an id to order several units"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    }
  }
}
